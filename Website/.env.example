# ===== Mẫu biến môi trường FRONTEND (Vite) =====
# Copy thành .env (local) hoặc nhập trên dashboard Vercel khi deploy.
# Lưu ý: biến Vite phải bắt đầu bằng VITE_ và được nhúng vào lúc BUILD.

# URL API backend (kèm /api ở cuối). Để trống = dùng http://localhost:3000/api (dev).
# Production trỏ tới backend trên Render, vd:
VITE_API_URL="https://nckh-backend.onrender.com/api"

# === Microsoft 365 login (tuỳ chọn — để trống thì nút M365 báo chưa cấu hình) ===
VITE_MSAL_CLIENT_ID=""
VITE_MSAL_TENANT_ID=""
VITE_MSAL_REDIRECT_URI=""
