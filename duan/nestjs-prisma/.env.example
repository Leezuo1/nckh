# ===== Mẫu biến môi trường BACKEND (NestJS) =====
# Copy file này thành .env (local) hoặc nhập trực tiếp trên dashboard Render khi deploy.
# KHÔNG commit file .env thật (đã có trong .gitignore).

# Chuỗi kết nối MongoDB Atlas. Lấy ở Atlas → Connect → Drivers.
# Nhớ thêm tên database vào cuối, vd: ...mongodb.net/nckh?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority"

# Cổng server. Render tự cấp PORT qua biến môi trường — để trống cũng được.
PORT=3000

# Secret ký JWT — chuỗi ngẫu nhiên mạnh (>= 32 ký tự). Thiếu biến này backend sẽ không khởi động.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-manh"

# Domain frontend được phép gọi API (CORS). Nhiều domain ngăn cách bằng dấu phẩy.
# vd: CORS_ORIGINS="https://nckh.vercel.app,https://nckh.vlu.edu.vn"
CORS_ORIGINS=""

# Mã số VLU (MSSV/MSGV) được cấp quyền Admin khi đăng nhập. Nhiều mã ngăn cách bằng dấu phẩy.
ADMIN_VLU_IDS=""

# (Tuỳ chọn) Giới hạn domain email được tự tạo tài khoản khi login Microsoft 365.
# Để trống = cho phép tất cả.
MS_ALLOWED_DOMAINS="vanlanguni.vn"
