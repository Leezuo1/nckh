generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
enum Gender {
  Male
  Female
}
enum UserRole {
  Student           // Sinh viên (SV)
  Lecturer          // Giảng viên hướng dẫn (GVHD)
  FacultyOfficer    // Cán bộ NCKH Khoa
  DepartmentOfficer // Cán bộ Phòng NCKH
  FacultyDean       // Trưởng Khoa
  Admin
}
enum UserStatus {
  Active
  Inactive
}
enum TopicStatus {
  Pending
  // ===== Quy trình duyệt nhiều cấp theo SRS (Phụ lục A, trạng thái 1→6) =====
  Draft                   // 1. Nháp — nhóm đang soạn thuyết minh
  PendingFacultyReview    // 2. Chờ Cán bộ NCKH Khoa duyệt
  FacultyRevision         // 3. Khoa yêu cầu chỉnh sửa
  PendingDepartmentReview // 4. Chờ Cán bộ Phòng NCKH duyệt
  DepartmentRevision      // 5. Phòng yêu cầu chỉnh sửa
  PendingProposalCouncil  // 6. Chờ Hội đồng đề cương
  PendingReviewCouncil    // 8. Chờ Hội đồng phản biện / nghiệm thu
  // ===== Vòng đời thực hiện (đã có) =====
  WaitingToStart // Chờ bắt đầu (sau khi duyệt assign)
  InProgress
  Reporting      // Báo Cáo (khoá, chỉ tải tài liệu)
  Editing        // Chỉnh Sửa (mở lại trong editDeadline, hết giờ → Done)
  Done           // hiển thị "Nghiệm thu"
  Cancelled
}
enum TopicParticipantRole {
  Supervisor //giảng viên hướng dẫn
  Leader //chủ nhiệm đề tài
  Member
  PendingMember //đang xin tham gia, chờ Leader duyệt (luồng ý tưởng cũ)
  Invited //GVHD mời, chờ SV chấp nhận (luồng SRS mới)
}
enum ApprovalLevel {
  Supervisor // GVHD duyệt sơ bộ / trình Khoa
  Faculty    // Cán bộ NCKH Khoa
  Department // Cán bộ Phòng NCKH
}
enum ApprovalDecision {
  Approved
  Rejected
}
enum CouncilType {
  Proposal // Hội đồng đề cương
  Review   // Hội đồng phản biện / nghiệm thu
}
enum ReviewOutcome {
  Extend // Gia hạn
  Redo   // Làm lại đề cương
  Cancel // Huỷ đề tài
}
enum AcademicDegree {
  Master
  Doctor
  Professor
  Other
}
enum FileFormat {
  Docx
  Pdf
  Other
}
model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  fullName String
  userId String @unique
  faculty String
  batch  String? //? là không diền thì hiện null
  gender Gender
  phone String @unique
  outlook String @unique
  role UserRole
  status UserStatus @default(Active)
  passwordHash String?
  refreshToken String?
  created DateTime @default(now())
  topicParticipant TopicParticipant[]
  submittedTopic Topic[] @relation("Submitter")
  uploadedDocuments Document[]
  activities Activity[]
}
model Topic {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String 
  topicName String
  description String?
  objective String?
  projectScope String?
  expectedProduct String?
  year String
  status TopicStatus @default(Pending)
  progress Int @default(0)
  isAssigned Boolean @default(false)
  isApproved Boolean @default(false)
  submitterId String? @db.ObjectId
  deadline DateTime
  durationMonths Int? @default(6) // Thời gian thực hiện (tháng), tối đa 12
  startDate DateTime? // Ngày bắt đầu dự án (khi chuyển sang InProgress)
  editDeadline DateTime? // Hạn cho phép chỉnh sửa khi ở trạng thái Editing (hết giờ → Done)
  teamMembersInfo Json? // Danh sách SV điền lúc xin assign (kể cả MSSV không khớp DB)
  progressHistory Json? // Lịch sử tiến độ: [{ date, value }]
  currentProposalVersion Int? // Phiên bản thuyết minh mới nhất (luồng SRS)
  batchId String? @db.ObjectId // Đợt đề tài (FR-04), raw ObjectId
  submitter User? @relation("Submitter", fields: [submitterId], references: [id])
  topicParticipant TopicParticipant[]
  documents Document[]
  timelines Timeline[]
  activities Activity[]
  proposalVersions ProposalVersion[]
  approvalRecords ApprovalRecord[]
  councils Council[]
}

// Lịch sử phiên bản hồ sơ thuyết minh (FR-11)
model ProposalVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  version Int
  content Json // các mục biểu mẫu thuyết minh
  submittedById String? @db.ObjectId // để raw ObjectId, không ràng buộc relation với User
  note String?
  created DateTime @default(now())
  topic Topic @relation(fields: [topicId], references: [id])
}

// Lịch sử duyệt nhiều cấp (FR-16)
model ApprovalRecord {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  level ApprovalLevel
  decision ApprovalDecision
  comment String?
  reviewerId String? @db.ObjectId // raw ObjectId, resolve tên thủ công khi hiển thị
  created DateTime @default(now())
  topic Topic @relation(fields: [topicId], references: [id])
}

// Hội đồng đề cương / phản biện (FR-17→20).
// Thành viên hội đồng KHÔNG có tài khoản — Cán bộ Phòng nhập kết quả hộ.
model Council {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  type CouncilType
  members Json? // danh sách tên thành viên hội đồng (chuỗi)
  scheduledAt DateTime? // thời gian họp
  location String?
  decision ApprovalDecision? // kết quả: Đạt / Không đạt (nhập sau khi họp)
  note String?
  outcome ReviewOutcome? // khi Hội đồng phản biện Không đạt: Gia hạn / Làm lại / Huỷ
  createdById String? @db.ObjectId
  created DateTime @default(now())
  topic Topic @relation(fields: [topicId], references: [id])
}
model TopicParticipant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  userId String? @db.ObjectId
  topicParticipantRole TopicParticipantRole
  academicDegree AcademicDegree? //Chọn học vị nếu là giảng viên
  assigned DateTime @default(now())
  topic Topic @relation(fields: [topicId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  @@unique([topicId, userId])
}
model Document {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  uploaderId String? @db.ObjectId
  fileName String       // tên gốc của file
  storedName String?    // tên file thật trên disk (để tải về)
  size Int
  format FileFormat
  note String?
  uploaded DateTime @default(now())
  topic Topic @relation(fields: [topicId], references: [id])
  uploader User? @relation(fields: [uploaderId], references: [id])
}
model Timeline {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  timelineName String
  deadline DateTime
  isCompleted Boolean @default(false)
  completed DateTime?
  topic Topic @relation(fields: [topicId], references: [id])
}
model Activity {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String? @db.ObjectId
  userId String? @db.ObjectId
  action String
  detail String?
  created DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  topic Topic? @relation(fields: [topicId], references: [id])
}

// Đợt đề tài (FR-04→06) — Cán bộ Phòng phát động
model Batch {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  year String
  description String?
  deadline DateTime // hạn nộp hồ sơ của đợt
  isOpen Boolean @default(true)
  createdById String? @db.ObjectId
  created DateTime @default(now())
}

model TopicAccess {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  topicId String @db.ObjectId
  userId String @db.ObjectId
  accessed DateTime @default(now())
}

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId  // người nhận
  title String
  message String
  link String?                  // optional link để click vào
  type String?                  // loại thông báo: "request_join", "idea_approved",...
  data Json?                    // metadata kèm theo (vd: { topicId, requesterId })
  isRead Boolean @default(false)
  created DateTime @default(now())
}
